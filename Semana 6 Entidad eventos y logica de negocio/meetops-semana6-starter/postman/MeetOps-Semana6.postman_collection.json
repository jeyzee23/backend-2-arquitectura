{
  "info": {
    "name": "MeetOps Semana 6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register Organizer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/sessions/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"email\": \"organizer@meetops.test\",\n  \"password\": \"Secret123!\",\n  \"role\": \"organizer\"\n}"
        }
      }
    },
    {
      "name": "Login Organizer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/sessions/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"organizer@meetops.test\",\n  \"password\": \"Secret123!\"\n}"
        }
      }
    },
    {
      "name": "Create Event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Workshop de Backend\",\n  \"description\": \"Auth, roles y reglas de negocio\",\n  \"category\": \"backend\",\n  \"date\": \"2027-03-15T19:00:00.000Z\",\n  \"location\": \"Buenos Aires\",\n  \"capacity\": 30,\n  \"price\": 0\n}"
        }
      }
    },
    {
      "name": "Create Event fecha pasada (debería ser 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Evento viejo\",\n  \"description\": \"No debería crearse\",\n  \"category\": \"backend\",\n  \"date\": \"2020-01-01T00:00:00.000Z\",\n  \"location\": \"Buenos Aires\",\n  \"capacity\": 10,\n  \"price\": 0\n}"
        }
      }
    },
    {
      "name": "List Events",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/events?status=published&category=backend&page=1&limit=5&sort=date"
      }
    },
    {
      "name": "Get Event",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/events/{{eventId}}"
      }
    },
    {
      "name": "Publish Event",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/events/{{eventId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"published\"\n}"
        }
      }
    },
    {
      "name": "Update Event",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/events/{{eventId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Workshop de Backend II\",\n  \"capacity\": 40\n}"
        }
      }
    },
    {
      "name": "Cancel Event",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/events/{{eventId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelled\"\n}"
        }
      }
    }
  ]
}
