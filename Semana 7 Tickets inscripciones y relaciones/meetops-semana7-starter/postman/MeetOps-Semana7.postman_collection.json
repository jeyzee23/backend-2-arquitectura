{
  "info": {
    "name": "MeetOps Semana 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/events/{{eventId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "events",
            "{{eventId}}"
          ]
        }
      }
    },
    {
      "name": "My Tickets",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/mine",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "mine"
          ]
        }
      }
    }
  ]
}