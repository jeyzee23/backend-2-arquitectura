{
  "info": {
    "_postman_id": "meetops-semana8-001",
    "name": "MeetOps — Semana 8",
    "description": "MeetOps Semana 8: capas DAO + Repository + DTO.\n\nOrden: Health → Register → Login → Current → Create event → List → Get by id → Ticket → My tickets → Logout.\n\nRegister genera email único; Login y Create event guardan `token` y `eventId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "ada@meetops.test" },
    { "key": "password", "value": "Secret123!" },
    { "key": "token", "value": "" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Register organizer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = `ada.${Date.now()}@meetops.test`;",
              "pm.collectionVariables.set('email', email);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"organizer\"\n}"
        },
        "url": "{{baseUrl}}/api/sessions/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.token) {",
              "  pm.collectionVariables.set('token', data.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/sessions/login"
      }
    },
    {
      "name": "Current (UserDTO sin password)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/sessions/current"
      }
    },
    {
      "name": "Create event",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.item && data.item.id) {",
              "  pm.collectionVariables.set('eventId', data.item.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"DAO Night\",\n  \"description\": \"Capas profesionales DAO / Repository / DTO\",\n  \"starts_at\": \"2026-09-01T19:00:00.000Z\",\n  \"capacity\": 40\n}"
        },
        "url": "{{baseUrl}}/api/events"
      }
    },
    {
      "name": "List events",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/events"
      }
    },
    {
      "name": "Get event by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/events/{{eventId}}"
      }
    },
    {
      "name": "Register ticket",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/tickets/events/{{eventId}}"
      }
    },
    {
      "name": "My tickets",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/tickets/mine"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/sessions/logout"
      }
    }
  ]
}
